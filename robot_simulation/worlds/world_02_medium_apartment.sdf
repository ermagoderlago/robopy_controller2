<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- =====================================================================
       LIVELLO 2 (PIU' COMPLICATO): world_02_medium_apartment.sdf
       Appartamento multi-stanza 10m x 8m (X in [-5, +5], Y in [-4, +4])
       con 4 ambienti comunicanti tramite porte da 0.90m, arredamento
       domestico (divano, tavolino, isola cucina, frigo, banco studio) e
       2 persone (Luca + Ospite):
         - Salotto Centrale: intorno a (0.0, 0.0)
         - Cucina Nord-Ovest: porta a X=-1.2, Y in [0.55, 1.45] -> target (-2.6, 1.2)
         - Studio Sud-Est: porta a Y=-0.9, X in [1.05, 1.95] -> target (2.2, -2.3)
         - Camera Sud-Ovest: porta a X=-1.2, Y in [-2.05, -1.15] -> target (-2.6, -1.6)
       ===================================================================== -->
  <world name="world_02_medium_apartment">
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250.0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.88 0.88 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>14 12</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14 12</size></plane></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muri Perimetrali 10m x 8m -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.15 0.15 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.15 0.15 1.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.90 1</ambient><diffuse>0.85 0.85 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.15 0.15 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.15 0.15 1.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.90 1</ambient><diffuse>0.85 0.85 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 8.15 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 8.15 1.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.90 1</ambient><diffuse>0.85 0.85 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 8.15 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 8.15 1.8</size></box></geometry>
          <material><ambient>0.85 0.85 0.90 1</ambient><diffuse>0.85 0.85 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parete Ovest X=-1.2 con 2 Porte da 0.90m:
         - Porta Cucina a Y in [0.55, 1.45]
         - Porta Camera a Y in [-2.05, -1.15] -->
    <model name="wall_west_div_top">
      <static>true</static>
      <pose>-1.2 2.725 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 2.55 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.12 2.55 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_div_mid">
      <static>true</static>
      <pose>-1.2 -0.30 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 1.70 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.12 1.70 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_div_bot">
      <static>true</static>
      <pose>-1.2 -3.025 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 1.95 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.12 1.95 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Tramezzo orizzontale tra Cucina e Camera a Y=0.0, X in [-5.0, -1.2] -->
    <model name="wall_cucina_camera_split">
      <static>true</static>
      <pose>-3.1 0.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.8 0.12 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.8 0.12 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parete Studio Sud-Est: Y=-0.9 per X in [0.6, 5.0] con Porta da 0.90m in X in [1.05, 1.95] -->
    <model name="wall_studio_left">
      <static>true</static>
      <pose>0.825 -0.9 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.45 0.12 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.45 0.12 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_studio_right">
      <static>true</static>
      <pose>3.475 -0.9 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.05 0.12 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.05 0.12 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_studio_west">
      <static>true</static>
      <pose>0.6 -2.45 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 3.10 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.12 3.10 1.8</size></box></geometry>
          <material><ambient>0.78 0.80 0.85 1</ambient><diffuse>0.78 0.80 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cuccia di Ricarica (0.0, 0.0) -->
    <model name="charging_dock">
      <static>true</static>
      <pose>0.0 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><cylinder><radius>0.30</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.85 0.3 1</ambient><diffuse>0.1 0.85 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arredamento Salotto -->
    <model name="sofa_salotto">
      <static>true</static>
      <pose>2.8 2.4 0.42 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.75 0.84</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.75 0.84</size></box></geometry>
          <material><ambient>0.25 0.38 0.65 1</ambient><diffuse>0.25 0.38 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="coffee_table">
      <static>true</static>
      <pose>2.8 1.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.85 0.50 0.50</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.85 0.50 0.50</size></box></geometry>
          <material><ambient>0.55 0.38 0.20 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arredamento Cucina -->
    <model name="fridge_cucina">
      <static>true</static>
      <pose>-4.3 3.2 0.85 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.75 0.75 1.70</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.75 0.75 1.70</size></box></geometry>
          <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.90 0.90 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_cucina">
      <static>true</static>
      <pose>-3.3 2.5 0.38 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.8 0.76</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.8 0.76</size></box></geometry>
          <material><ambient>0.60 0.42 0.22 1</ambient><diffuse>0.60 0.42 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arredamento Studio -->
    <model name="workbench_studio">
      <static>true</static>
      <pose>3.7 -2.8 0.38 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.3 0.65 0.76</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.3 0.65 0.76</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Arredamento Camera -->
    <model name="bed_camera">
      <static>true</static>
      <pose>-3.8 -3.0 0.30 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 1.2 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 1.2 0.60</size></box></geometry>
          <material><ambient>0.70 0.35 0.40 1</ambient><diffuse>0.70 0.35 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Attori Umani Virtuali -->
    <model name="human_luca">
      <static>true</static>
      <pose>1.1 2.8 0.85 0 0 3.14159</pose>
      <link name="body">
        <collision name="c"><geometry><cylinder><radius>0.22</radius><length>1.70</length></cylinder></geometry></collision>
        <visual name="torso">
          <geometry><cylinder><radius>0.22</radius><length>1.40</length></cylinder></geometry>
          <material><ambient>0.15 0.55 0.85 1</ambient><diffuse>0.15 0.55 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="human_guest">
      <static>true</static>
      <pose>-2.2 -3.1 0.85 0 0 1.57</pose>
      <link name="body">
        <collision name="c"><geometry><cylinder><radius>0.22</radius><length>1.70</length></cylinder></geometry></collision>
        <visual name="torso">
          <geometry><cylinder><radius>0.22</radius><length>1.40</length></cylinder></geometry>
          <material><ambient>0.85 0.45 0.15 1</ambient><diffuse>0.85 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
