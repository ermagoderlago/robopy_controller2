<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      
      <!-- Esecuzione Standard: Ripianifica a 1.0Hz e Segui Path -->
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="/global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="/local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <!-- Sequenza di Sblocco Sopravvivenza (FM-NAV-019: Safe Recovery senza spin cieco) -->
      <Sequence name="SurvivalRecoverySequence">
        <!-- 1. Indietreggia controllato e lento per disimpegno sicuro -->
        <BackUp backup_dist="0.08" backup_speed="0.08" name="DisengageBackUp" error_code_id="{backup_error_code}"/>
        
        <Wait wait_duration="0.5"/>
        
        <!-- 2. Pulisci la memoria locale e globale per sbloccare costmap transitorie -->
        <ClearEntireCostmap name="ClearGlobalCostmap-Recovery" service_name="/global_costmap/clear_entirely_global_costmap"/>
        <ClearEntireCostmap name="ClearLocalCostmap-Recovery" service_name="/local_costmap/clear_entirely_local_costmap"/>
        
        <!-- 3. Breve pausa di stabilizzazione sensoriale (nessun spin cieco fuori dal FoV camera) -->
        <Wait wait_duration="0.5"/>
        
        <!-- 4. Ricalcola un percorso fresco dallo spazio aggiornato -->
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
      </Sequence>
      
    </RecoveryNode>
  </BehaviorTree>
</root>
