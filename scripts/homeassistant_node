#!/usr/bin/env python3
import sys
import os
import signal

# Dynamic path resolution to ensure site-packages is in sys.path
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PKG_INSTALL_ROOT = os.path.dirname(os.path.dirname(SCRIPT_DIR))
# We try to detect the python version dynamically
try:
    import platform
    py_ver = f"{sys.version_info.major}.{sys.version_info.minor}"
    SITE_PKGS = os.path.join(PKG_INSTALL_ROOT, f'lib/python{py_ver}/site-packages')
    if os.path.exists(SITE_PKGS):
        sys.path.insert(0, SITE_PKGS)
except:
    pass

try:
    from robopy_controller.nodes.homeassistant_node import main
except ImportError:
    # Fallback to local source if available during development
    WORKSPACE_ROOT = os.path.dirname(os.path.dirname(PKG_INSTALL_ROOT))
    sys.path.insert(0, WORKSPACE_ROOT)
    from robopy_controller.nodes.homeassistant_node import main

def signal_handler(sig, frame):
    pass

if __name__ == '__main__':
    signal.signal(signal.SIGINT, signal_handler)
    
    try:
        main()
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print(f"Error in homeassistant_node wrapper: {e}", file=sys.stderr)
        sys.exit(1)

