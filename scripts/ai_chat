#!/usr/bin/env python3
"""
Simple CLI to send text to the AI node.
Usage: ros2 run robopy_controller ai_chat
Then just type your message and press Enter.
"""
import rclpy
from rclpy.node import Node
from std_msgs.msg import String
import sys

class AIChatCLI(Node):
    def __init__(self):
        super().__init__('ai_chat_cli')
        self.pub = self.create_publisher(String, '/ai/input/text', 10)
        self.sub = self.create_subscription(
            String, '/ai/conversation/response', self.on_response, 10)
        print("🤖 AI Chat - Scrivi un messaggio e premi Invio (Ctrl+C per uscire)")
        print("-" * 50)
    
    def on_response(self, msg):
        print(f"\n🤖 AI: {msg.data}\n> ", end='', flush=True)
    
    def send(self, text):
        msg = String()
        msg.data = text
        self.pub.publish(msg)

def main():
    rclpy.init()
    node = AIChatCLI()
    
    import threading
    spin_thread = threading.Thread(target=rclpy.spin, args=(node,), daemon=True)
    spin_thread.start()
    
    try:
        while True:
            text = input("> ")
            if text.strip():
                node.send(text)
    except (KeyboardInterrupt, EOFError):
        print("\n👋 Bye!")
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
