#!/bin/bash
# Wrapper robusto per respeaker_vui_node (RoboPY Marcus)

# Determina dinamicamente la root del workspace
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
# SCRIPT_DIR is .../lib/robopy_controller/
# Go up 2 levels to reach pkg root (.../install/robopy_controller/)
PKG_INSTALL_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
# Go up 2 more levels to reach workspace root (sibling of install/)
WORKSPACE_ROOT="$(dirname "$(dirname "$PKG_INSTALL_ROOT")")"

# 1. Carica Ambiente ROS 2
if [ -f "/opt/ros/jazzy/setup.bash" ]; then
    source /opt/ros/jazzy/setup.bash
fi

# 2. Carica Ambiente Virtuale (Python)
if [ -f "/home/robopy/ros2_venv/bin/activate" ]; then
    source /home/robopy/ros2_venv/bin/activate
fi

# 3. Carica Workspace RoboPY
if [ -f "$WORKSPACE_ROOT/install/setup.bash" ]; then
    source "$WORKSPACE_ROOT/install/setup.bash"
fi

# 4. Carica chiavi API (necessarie per Porcupine e Gemini)
if [ -f "$WORKSPACE_ROOT/setup_keys.sh" ]; then
    source "$WORKSPACE_ROOT/setup_keys.sh"
fi

# 5. Esecuzione Nodo
# Cerchiamo il modulo nel site-packages dinamico
PYTHON_VER=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
MODULE_PATH="$PKG_INSTALL_ROOT/lib/python$PYTHON_VER/site-packages/robopy_controller/nodes/respeaker_vui_node.py"

if [ ! -f "$MODULE_PATH" ]; then
    echo "ERRORE: Modulo non trovato in $MODULE_PATH"
    # Fallback al path sorgente se disponibile
    MODULE_PATH="$WORKSPACE_ROOT/robopy_controller/nodes/respeaker_vui_node.py"
fi

exec python3 "$MODULE_PATH" "$@"
