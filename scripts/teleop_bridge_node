#!/usr/bin/env python3
import sys
import importlib.util

# Load teleop_bridge_node directly from the correct path
MODULE_PATH = '/home/robopy/robopy/robopi_controller/robopy_controller_host/robopy_controller/nodes/teleop_bridge_node.py'

spec = importlib.util.spec_from_file_location("teleop_bridge_node", MODULE_PATH)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

if __name__ == '__main__':
    module.main()
