#!/usr/bin/env python3
import sys
import rclpy
import signal
from robopy_controller.nodes.robot_health_supervisor import main

def signal_handler(sig, frame):
    pass

if __name__ == '__main__':
    signal.signal(signal.SIGINT, signal_handler)
    try:
        main(sys.argv)
    except KeyboardInterrupt:
        pass
    except SystemExit:
        pass
    except Exception as e:
        print(f"Error in robot_health_supervisor wrapper: {e}", file=sys.stderr)
        sys.exit(1)
