#!/usr/bin/env python3
import sys
import os
import importlib.util
import subprocess

# Auto-load GEMINI_API_KEY from setup_keys.sh if not already set
if not os.environ.get('GEMINI_API_KEY'):
    setup_keys_path = '/home/robopy/robopy/robopi_controller/robopy_controller_host/setup_keys.sh'
    if os.path.exists(setup_keys_path):
        # Extract the API key from the script
        try:
            with open(setup_keys_path, 'r') as f:
                for line in f:
                    if line.startswith('export GEMINI_API_KEY='):
                        key = line.split('=', 1)[1].strip().strip('"').strip("'")
                        os.environ['GEMINI_API_KEY'] = key
                        print(f"✅ GEMINI_API_KEY loaded from {setup_keys_path}")
                        break
        except Exception as e:
            print(f"⚠️ Could not load API key from {setup_keys_path}: {e}")

# Load module directly from the correct path to avoid namespace conflict
# NOTE: This path depends on the install location derived from colcon build
MODULE_PATH = '/home/robopy/robopy/robopi_controller/robopy_controller_host/install/robopy_controller/lib/python3.11/site-packages/robopy_controller/nodes/robot_ai_node.py'

try:
    spec = importlib.util.spec_from_file_location("module", MODULE_PATH)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
except FileNotFoundError:
    print(f"Error: Could not find module at {MODULE_PATH}")
    print("Make sure you have built the workspace: colcon build --packages-select robopy_controller")
    sys.exit(1)

if __name__ == '__main__':
    module.main()
