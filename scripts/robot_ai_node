#!/usr/bin/env python3
import sys
import os

# Auto-load GEMINI_API_KEY from setup_keys.sh se non impostata
if not os.environ.get('GEMINI_API_KEY'):
    setup_keys_path = '/mnt/ssd/robopy_controller_host/setup_keys.sh'
    if os.path.exists(setup_keys_path):
        try:
            with open(setup_keys_path, 'r') as f:
                for line in f:
                    if line.startswith('export GEMINI_API_KEY='):
                        key = line.split('=', 1)[1].strip().strip('"').strip("'")
                        os.environ['GEMINI_API_KEY'] = key
                        print(f"✅ GEMINI_API_KEY loaded from {setup_keys_path}")
                        break
        except Exception as e:
            print(f"⚠️ Could not load API key from {setup_keys_path}: {e}")

# Importazione standard di ROS 2 (funziona ora che il namespace è pulito)
from robopy_controller.nodes.robot_ai_node import main

if __name__ == '__main__':
    sys.exit(main())
