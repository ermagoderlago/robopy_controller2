<?xml version="1.0"?>
<robot name="tracked_robot">

  <!-- ==============================
       BASE LINK
       ============================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://robopy_controller/urdf/Marcus.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.052" iyy="0.052" izz="0.052"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ==============================
       TRACKS
       ============================== -->
  <link name="left_track"/>
  <link name="right_track"/>

  <joint name="left_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track"/>
    <origin xyz="0 0.08 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="right_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track"/>
    <origin xyz="0 -0.08 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ==============================
       IMU (LOGICA, NON depthai)
       ============================== -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.10 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ==============================
       ULTRASONIC
       ============================== -->
  <link name="ultrasonic_link"/>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.10 0.0 0.05" rpy="1.5708 0 0"/>
  </joint>

  <!-- ==============================
       CAMERA (OAK-D Lite)
       ============================== -->
  <link name="camera_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- posizione e inclinazione REALI della OAK-D Lite: 8° inclinata verso l'ALTO (-0.1396 rad) -->
    <origin xyz="0.0332 0.0 0.2616" rpy="0 -0.1396 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- REP-103: rotazione fissa camera_link → optical frame -->
    <!-- roll=-π/2, pitch=0, yaw=-π/2 -->
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
