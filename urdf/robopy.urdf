<?xml version="1.0"?>
<robot name="marcus">

  <!-- ==============================
       BASE LINK (Origin at axle centerline / robot chassis center)
       ============================== -->
  <link name="base_link">
    <!-- Visual: Main chassis block -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.22 0.12"/>
      </geometry>
      <material name="marcus_dark">
        <color rgba="0.18 0.18 0.22 1.0"/>
      </material>
    </visual>

    <!-- Visual: Mesh 3D STL di Marcus -->
    <visual>
      <origin xyz="0 0 0.10" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://robopy_controller/urdf/Marcus.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="marcus_orange">
        <color rgba="0.95 0.45 0.10 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.22 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- ==============================
       BASE FOOTPRINT (Ground projection at Z = 0)
       ============================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.0335" rpy="0 0 0"/>
  </joint>

  <!-- ==============================
       TRACKS & WHEELS (67mm diameter, 285mm separation)
       ============================== -->
  <link name="left_track">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0335" length="0.04"/>
      </geometry>
      <material name="track_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="left_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track"/>
    <origin xyz="0 0.1425 0.0" rpy="0 0 0"/>
  </joint>

  <link name="right_track">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0335" length="0.04"/>
      </geometry>
      <material name="track_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="right_track_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track"/>
    <origin xyz="0 -0.1425 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ==============================
       RPLIDAR C1 (360° ToF Laser Scan, Z=0.18m, yaw=180°)
       ============================== -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.15 0.35 0.85 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.08 0.0 0.18" rpy="0.0 0.0 3.14159265"/>
  </joint>

  <!-- ==============================
       OAK-D LITE CAMERA (Z=0.2616m, pitch=8° UP / -0.1396 rad)
       ============================== -->
  <link name="oak_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.09 0.03"/>
      </geometry>
      <material name="camera_silver">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="oak_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="oak_camera_link"/>
    <origin xyz="0.0332 0.0 0.2616" rpy="0.0 -0.1396 0.0"/>
  </joint>

  <!-- REP-103: Optical frame for RGB & Depth (roll=-π/2, yaw=-π/2) -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="oak_camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0.0 -1.5708"/>
  </joint>

  <link name="oak_left_camera_optical_frame"/>

  <joint name="oak_left_camera_optical_joint" type="fixed">
    <parent link="oak_camera_link"/>
    <child link="oak_left_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0.0 -1.5708"/>
  </joint>

  <!-- OAK IMU -->
  <link name="oak_imu_frame"/>

  <joint name="oak_imu_joint" type="fixed">
    <parent link="oak_camera_link"/>
    <child link="oak_imu_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==============================
       CHASSIS IMU & SENSORS
       ============================== -->
  <link name="chassis_imu_link"/>

  <joint name="chassis_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.10 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Ultrasonic Sensor -->
  <link name="ultrasonic_sensor"/>

  <joint name="ultrasonic_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_sensor"/>
    <origin xyz="0.12 0.0 0.05" rpy="0 0 0"/>
  </joint>

</robot>
