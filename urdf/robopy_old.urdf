<?xml version="1.0"?>
<robot name="tracked_robot">

  <!-- ==============================
       BASE LINK
       ============================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.20 0.20 0.15"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.20 0.20 0.15"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.052" iyy="0.052" izz="0.052" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ==============================
       LEFT / RIGHT TRACKS
       ============================== -->
  <link name="left_track">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 1.5708 0"/>
      <mass value="1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="right_track">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 1.5708 0"/>
      <mass value="1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_track"/>
    <origin xyz="0 0.08 0.05" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_track"/>
    <origin xyz="0 -0.08 0.05" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==============================
       CAMERA
       - camera_link: geometria fisica del modulo
       - camera_joint: montaggio fisico (pitch = -30°)
       - camera_optical_frame: frame ottico secondo REP-103 (NON modificare)
       ============================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.02 0.02"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.02 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- camera montata con pitch = -30° (verso il basso) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- pitch = -30° = -0.5235987755982988 rad -->
    <origin xyz="0.10 0.0 0.15" rpy="0 -0.2 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- Rotazione REP-103 tra camera_link e camera_optical_frame: lasciare così -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/> 
    <!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->

  </joint>

  <!-- ==============================
       IMU (integrata su OAK-D Lite)
       - Nota: la IMU fisicamente è montata sulla stessa board della camera,
         ma non applichiamo correzioni sugli assi nel URDF. La rimappatura
         device->ROS (x, -y, -z) va fatta nel software (Madgwick / publisher).
       ============================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- IMU joint: posizione corretta ma senza rotazioni -->
  <joint name="imu_joint" type="fixed">
    <!-- <parent link="base_link"/> -->
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- posizione relativa (adatta se vuoi spostare) -->
    <!--<origin xyz="0.10 0.0 0.05" rpy="0 0 0"/>-->
    <!-- <origin xyz="0.10 0.0 0.15" rpy="0 -0.2 0"/> -->
    <origin xyz="0.10 0.0 0.15" rpy="0 -0.2 0"/>

  </joint>

  <!-- ==============================
       ULTRASONIC
       ============================== -->
  <link name="ultrasonic_link">
    <visual>
      <geometry><cylinder radius="0.015" length="0.03"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.1 0.0 0.05" rpy="1.5708 0 0"/>
  </joint>

</robot>
